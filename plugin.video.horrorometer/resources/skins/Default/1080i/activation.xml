<window type="dialog">
  <defaultcontrol always="true">10</defaultcontrol>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="C0000000">horrorometer-solid.png</texture>
    </control>
    <control type="group">
      <left>300</left><top>235</top>
      <control type="image">
        <left>0</left><top>0</top><width>1320</width><height>610</height>
        <texture colordiffuse="FF141418">horrorometer-solid.png</texture>
      </control>
      <control type="image">
        <left>50</left><top>85</top><width>440</width><height>440</height>
        <aspectratio>keep</aspectratio>
        <texture>$INFO[Window.Property(Horrorometer.QR)]</texture>
      </control>
      <control type="label">
        <left>550</left><top>85</top><width>710</width><height>55</height>
        <font>font37</font><textcolor>FFFFFFFF</textcolor>
        <label>Scan to sign in</label>
      </control>
      <control type="label">
        <left>550</left><top>156</top><width>710</width><height>42</height>
        <font>font25</font><textcolor>FFE5E5EB</textcolor>
        <label>Point your phone camera at the QR code.</label>
      </control>
      <control type="label">
        <left>550</left><top>200</top><width>710</width><height>42</height>
        <font>font25</font><textcolor>FFE5E5EB</textcolor>
        <label>Approve access on Horrorometer to continue.</label>
      </control>
      <control type="label">
        <left>550</left><top>282</top><width>710</width><height>38</height>
        <font>font25</font><textcolor>FFADADB8</textcolor>
        <label>To enter the code manually, visit</label>
      </control>
      <control type="label">
        <left>550</left><top>326</top><width>710</width><height>42</height>
        <font>font30</font><textcolor>FFFFFFFF</textcolor>
        <label>$INFO[Window.Property(Horrorometer.URL)]</label>
      </control>
      <control type="label">
        <left>550</left><top>378</top><width>710</width><height>58</height>
        <font>font37</font><textcolor>FFFFFFFF</textcolor>
        <label>$INFO[Window.Property(Horrorometer.Code),Code: ]</label>
      </control>
      <control type="button" id="10">
        <left>550</left><top>465</top><width>200</width><height>58</height>
        <font>font25</font><textcolor>FFFFFFFF</textcolor><align>center</align>
        <texturefocus colordiffuse="FFA41C1C">horrorometer-solid.png</texturefocus>
        <texturenofocus colordiffuse="FF33333B">horrorometer-solid.png</texturenofocus>
        <label>Cancel</label>
      </control>
    </control>
  </controls>
</window>
