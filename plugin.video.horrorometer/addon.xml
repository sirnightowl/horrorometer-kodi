<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.horrorometer" name="Horrorometer" version="0.1.0" provider-name="Horrorometer">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.requests" version="2.31.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en">Browse your Horrorometer horror watchlist</summary>
    <description lang="en">
Connect Kodi to your Horrorometer account and browse your horror watchlist.
Authorize via a simple code — no password needed on Kodi.
    </description>
    <disclaimer lang="en">
Requires a free Horrorometer account at horrorometer.com.
    </disclaimer>
    <language>en</language>
    <platform>all</platform>
    <license>MIT</license>
    <forum>https://github.com/sirnightowl/horrorometer-kodi/issues</forum>
    <website>https://horrorometer.com</website>
    <source>https://github.com/sirnightowl/horrorometer-kodi</source>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
      <screenshot>resources/screenshot01.jpg</screenshot>
    </assets>
    <news>v0.1.0 — Initial release</news>
  </extension>
</addon>